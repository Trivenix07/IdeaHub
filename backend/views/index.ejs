<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IdeaHub | Pitch. Vote. Build.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: '#6366f1',
                        surface: '#0a0a0c',
                        card: '#121215'
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'reveal': 'reveal 0.8s cubic-bezier(0, 0, 0.2, 1) forwards',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        reveal: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #050506;
            color: #fafafa;
            overflow-x: hidden;
        }

        /* Cursor Glow Effect */
        #cursor-glow {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            pointer-events: none;
            background: radial-gradient(circle 450px at var(--x, 50%) var(--y, 50%), rgba(99, 102, 241, 0.12), transparent 80%);
            z-index: 1;
        }

        /* Mirror Glass Effect */
        .glass-card {
            background: rgba(18, 18, 21, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.4);
            background: rgba(22, 22, 26, 0.9);
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .text-gradient {
            background: linear-gradient(to bottom right, #fff 30%, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050506; }
        ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 10px; }
    </style>
</head>
<body class="selection:bg-brand/30">

    <div id="cursor-glow"></div>

    <nav class="flex justify-between items-center px-8 py-5 sticky top-0 bg-[#050506]/80 backdrop-blur-xl z-50 border-b border-white/5">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-brand rounded-xl flex items-center justify-center text-white shadow-[0_0_20px_rgba(99,102,241,0.4)] animate-pulse">
                <i class="ri-lightbulb-flash-line text-lg"></i>
            </div>
            <h1 class="text-lg font-bold uppercase tracking-[0.2em]">ideahub</h1>
        </div>
        
        <div class="flex items-center gap-8 font-bold text-[10px] tracking-[0.2em] uppercase">
            <% if (loggedInUser) { %>
                <a href="/profile" class="hover:text-brand transition-colors">My Profile</a>
                <a href="/logout" class="bg-red-500/10 text-red-400 px-4 py-2 rounded-lg border border-red-500/20 hover:bg-red-500 hover:text-white transition">Logout</a>
            <% } else { %>
                <a href="/login" class="text-zinc-500 hover:text-white transition">Log In</a>
                <a href="/register" class="bg-white text-black px-6 py-2.5 rounded-full hover:bg-zinc-200 transition shadow-[0_0_20px_rgba(255,255,255,0.1)]">Sign Up</a>
            <% } %>
        </div>
    </nav>

    <header class="max-w-5xl mx-auto text-center py-24 px-6 relative">
        <div class="animate-reveal opacity-0" style="animation-delay: 0.1s">
            <span class="inline-block px-4 py-1.5 rounded-full border border-brand/20 bg-brand/5 text-brand font-bold text-[10px] tracking-widest uppercase mb-8">
                🚀 The Public Notebook for Builders
            </span>
        </div>
        <h1 class="animate-reveal opacity-0 text-6xl md:text-8xl font-extrabold tracking-tighter leading-[0.9] mb-8 text-gradient" style="animation-delay: 0.2s">
            Pitch ideas you can't <br> <span class="text-zinc-600 italic font-light">stop thinking about.</span>
        </h1>
        <p class="animate-reveal opacity-0 text-zinc-500 text-lg max-w-xl mx-auto font-medium" style="animation-delay: 0.3s">
            The community votes, debates, and helps you ship. No noise. Just high-signal startup ideas.
        </p>
    </header>

    <main class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-3 gap-12 pb-32 relative z-10">
        
        <div class="lg:col-span-2">
            <div class="flex items-center justify-between mb-10 border-b border-white/5 pb-6">
                <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-brand rounded-full animate-ping"></span> Global Feed
                </h3>
            </div>

            <div class="space-y-6">
                <% if(posts && posts.length > 0) { %>
                    <% posts.reverse().forEach(post => { %>
                        <div class="glass-card p-8 rounded-[2rem] group relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                            
                            <div class="flex items-center gap-4 mb-8">
                                <div class="w-12 h-12 bg-gradient-to-br from-zinc-800 to-zinc-900 border border-white/10 rounded-2xl flex items-center justify-center font-bold text-brand text-lg">
                                    <%= post.user ? post.user.username.charAt(0).toUpperCase() : '?' %>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-white tracking-tight">@<%= post.user ? post.user.username : 'anonymous' %></p>
                                    <p class="text-[9px] font-bold text-zinc-600 uppercase tracking-widest">Digital Architect</p>
                                </div>
                            </div>

                            <h2 class="text-2xl font-medium text-zinc-200 leading-snug mb-10 group-hover:text-white transition-colors">
                                "<%= post.content %>"
                            </h2>

                            <div class="flex items-center justify-between pt-6 border-t border-white/5">
                                <div class="flex items-center gap-4">

    <!-- ❤️ LIKE -->
    <a href="/like/<%= post._id %>" 
       class="flex items-center gap-2 bg-brand/5 hover:bg-brand/20 px-5 py-2.5 rounded-xl border border-brand/10 transition-all">
        <i class="ri-heart-3-fill text-brand"></i>
        <span class="text-xs font-bold text-zinc-300"><%= post.likes.length %></span>
    </a>

 <!-- 🤝 COLLABORATE -->

<%
let request = null;

if (notifications) {
    request = notifications.find(n => 
        n.post._id.toString() === post._id.toString() &&
        n.sender._id.toString() === loggedInUser?.userid
    );
}
%>

<% if (request && request.status === "pending") { %>

    <div class="flex items-center gap-2 bg-yellow-500/20 px-5 py-2.5 rounded-xl border border-yellow-500/30">
        <i class="ri-time-line text-yellow-400"></i>
        <span class="text-xs font-bold text-yellow-300">Request Sent</span>
    </div>

<% } else if (request && request.status === "accepted") { %>

    <div class="flex items-center gap-2 bg-green-500/20 px-5 py-2.5 rounded-xl border border-green-500/30">
        <i class="ri-check-line text-green-400"></i>
        <span class="text-xs font-bold text-green-300">Collaborated</span>
    </div>

<% } else { %>

    <a href="/collab/<%= post._id %>" 
       class="flex items-center gap-2 bg-green-500/10 hover:bg-green-500/20 px-5 py-2.5 rounded-xl border border-green-500/20 transition-all">
        <i class="ri-user-add-line text-green-400"></i>
        <span class="text-xs font-bold text-green-300">Collaborate</span>
    </a>

<% } %>

</div>
                                
                                <a href="/login" class="text-[10px] font-black uppercase tracking-widest text-zinc-600 hover:text-brand transition-all flex items-center gap-2">
                                    Expand <i class="ri-arrow-right-up-line"></i>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-20 bg-card/50 rounded-[2.5rem] border border-dashed border-white/5">
                        <i class="ri-ghost-line text-5xl text-zinc-800 mb-4 block"></i>
                        <p class="text-zinc-600 font-medium italic">The silence is loud. Pitch something.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="space-y-8">
            <div class="bg-brand p-1 rounded-[2.5rem] animate-float">
                <div class="bg-surface p-10 rounded-[2.3rem] relative overflow-hidden h-full">
                    <div class="absolute -right-10 -top-10 w-40 h-40 bg-brand/20 rounded-full blur-[60px]"></div>
                    <h4 class="text-[10px] font-black uppercase tracking-[0.4em] text-brand mb-8 italic">Manifesto</h4>
                    <p class="text-zinc-400 text-sm leading-relaxed font-medium mb-6">
                        IdeaHub is for the dreamers who <span class="text-white">ship</span>. We filter the noise to find the <span class="text-brand">signal</span>.
                    </p>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest text-zinc-500">
                            <i class="ri-checkbox-circle-fill text-brand"></i> Pure Innovation
                        </div>
                        <div class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest text-zinc-500">
                            <i class="ri-checkbox-circle-fill text-brand"></i> High Signal
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card p-10 rounded-[2.5rem]">
                <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500 mb-4 italic">Ecosystem Stats</h4>
                <div class="flex items-end gap-3">
                    <span class="text-7xl font-black tracking-tighter text-white"><%= posts.length %></span>
                    <div class="mb-2">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-brand leading-none">Global</p>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-white leading-none">Pitches</p>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script>
        // Cursor Lightning Follow Logic
        const glow = document.getElementById('cursor-glow');
        window.addEventListener('mousemove', (e) => {
            glow.style.setProperty('--x', e.clientX + 'px');
            glow.style.setProperty('--y', e.clientY + 'px');
        });
    </script>
</body>
</html>