   <!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IdeaHub | Your Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: '#6366f1',
                        surface: '#050506',
                        card: '#121215'
                    },
                    animation: {
                        'reveal': 'reveal 0.6s cubic-bezier(0, 0, 0.2, 1) forwards',
                    },
                    keyframes: {
                        reveal: {
                            '0%': { opacity: '0', transform: 'translateY(15px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #050506;
            color: #fafafa;
            overflow-x: hidden;
        }

        /* Cursor Glow */
        #cursor-glow {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            pointer-events: none;
            background: radial-gradient(circle 400px at var(--x, 50%) var(--y, 50%), rgba(99, 102, 241, 0.08), transparent 80%);
            z-index: 1;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(18, 18, 21, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
            background: rgba(22, 22, 26, 0.8);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        /* Custom Input Focus */
        .idea-textarea {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

        .idea-textarea:focus {
            background: rgba(255, 255, 255, 0.04);
            border-color: #6366f1;
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.1);
        }

        .btn-brand {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            transition: all 0.3s ease;
        }

        .btn-brand:hover {
            filter: brightness(1.1);
            box-shadow: 0 0 25px rgba(99, 102, 241, 0.4);
            transform: scale(1.02);
        }
    </style>
</head>
<body class="selection:bg-brand/30">

    <div id="cursor-glow"></div>

    <nav class="flex justify-between items-center px-10 py-5 sticky top-0 bg-[#050506]/80 backdrop-blur-xl z-50 border-b border-white/5">
        <div class="flex items-center gap-10">
            <div class="flex items-center gap-3 group cursor-pointer">
                <div class="w-10 h-10 bg-brand rounded-xl flex items-center justify-center text-white shadow-[0_0_20px_rgba(99,102,241,0.3)] transition-transform group-hover:rotate-12">
                    <i class="ri-lightbulb-flash-fill text-xl"></i>
                </div>
                <h1 class="text-xl font-bold uppercase tracking-[0.2em]">ideahub</h1>
            </div>

            <a href="/" class="hidden md:flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 hover:text-white transition">
                <i class="ri-compass-3-line text-lg"></i>
                Explore Feed
            </a>
        </div>
        
        <div class="flex items-center gap-8">
            <div class="text-right hidden sm:block">
                <p class="text-[9px] font-black uppercase tracking-[0.2em] text-zinc-500 leading-none mb-1">Architect</p>
                <p class="text-sm font-bold text-white tracking-tight"><%= user.name %></p>
            </div>
            <a href="/logout" class="bg-red-500/10 text-red-400 px-6 py-2.5 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-red-500 hover:text-white transition-all border border-red-500/20">
                Exit Studio
            </a>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-3 gap-16 relative z-10">
        
        <div class="lg:col-span-2 space-y-16">
            
            <div class="animate-reveal opacity-0" style="animation-delay: 0.1s">
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-zinc-600 mb-8 flex items-center gap-4">
                    <span class="w-12 h-[1px] bg-zinc-800"></span> New Concept
                </h3>
                <form action="/post" method="POST" class="group">
                    <textarea name="content" placeholder="What's the next big thing?" required
                        class="idea-textarea w-full p-10 rounded-[2.5rem] outline-none h-48 mb-6 transition-all text-xl font-medium leading-relaxed placeholder:text-zinc-700"></textarea>
                    <button type="submit" class="btn-brand text-white px-12 py-5 rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] shadow-2xl active:scale-95">
                        Broadcast Idea
                    </button>
                </form>
            </div>

            <div class="space-y-10 animate-reveal opacity-0" style="animation-delay: 0.3s">
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-zinc-600 mb-4 flex items-center gap-4">
                    <span class="w-12 h-[1px] bg-zinc-800"></span> Your Notebook
                </h3>

                <% if(user.posts && user.posts.length > 0) { %>
                    <% user.posts.reverse().forEach(post => { %>
                        <div class="glass-card rounded-[2.5rem] p-10 group relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

                            <div class="flex justify-between items-center mb-8">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-zinc-800 rounded-2xl flex items-center justify-center text-brand font-bold">
                                        <%= user.username.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <p class="text-[10px] text-zinc-500 font-black uppercase tracking-widest">Published by you</p>
                                        <p class="text-xs font-bold text-white">@<%= user.username %></p>
                                    </div>
                                </div>
                                <span class="text-[9px] font-black text-zinc-700 uppercase tracking-tighter italic">Secured</span>
                            </div>

                            <p class="text-2xl font-medium text-zinc-200 mb-12 leading-relaxed group-hover:text-white transition-colors">
                                <%= post.content %>
                            </p>
                            
                            <div class="flex items-center justify-between border-t border-white/5 pt-8">
                                <div class="flex items-center gap-4">
                                    <a href="/like/<%= post._id %>" class="flex items-center gap-2 bg-white/5 px-6 py-3 rounded-2xl border border-white/5 hover:bg-red-500/10 hover:border-red-500/20 group/like transition-all">
                                        <i class="<%= post.likes.includes(user._id) ? 'ri-heart-3-fill text-red-500' : 'ri-heart-3-line text-zinc-500' %> text-xl group-hover/like:scale-110 transition-transform"></i>
                                        <span class="text-sm font-bold <%= post.likes.includes(user._id) ? 'text-red-500' : 'text-zinc-400' %>"><%= post.likes.length %></span>
                                    </a>

                                    <a href="/edit/<%= post._id %>" class="flex items-center gap-2 bg-white/5 px-6 py-3 rounded-2xl border border-white/5 hover:bg-white/10 hover:border-white/20 transition-all">
                                        <i class="ri-quill-pen-line text-xl text-zinc-500"></i>
                                        <span class="text-[10px] font-black text-zinc-500 uppercase tracking-widest">Refine</span>
                                    </a>
                                </div>

                                <a href="/delete/<%= post._id %>" 
                                   class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5 text-zinc-700 hover:bg-red-500 hover:text-white transition-all">
                                    <i class="ri-delete-bin-7-line text-xl"></i>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-24 glass-card rounded-[3rem] border-dashed">
                        <i class="ri-ghost-smile-line text-6xl text-zinc-800 mb-6 block animate-bounce"></i>
                        <p class="text-zinc-500 font-bold uppercase tracking-widest text-[10px]">The canvas is blank. Start creating.</p>
                    </div>
                <% } %>
            </div>
        </div>
       <div class="space-y-10 animate-reveal opacity-0" style="animation-delay: 0.5s">
      <!-- collab -->
               <a href="/requests" 
   class="block glass-card p-12 rounded-[3rem] relative overflow-hidden group cursor-pointer h-fit">

    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

    <div class="absolute -left-6 -top-6 w-24 h-24 bg-green-500/10 rounded-full blur-2xl"></div>

    <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500 mb-4 italic">
        Collaboration
    </h4>

    <div class="flex items-center gap-3">
        <span class="text-8xl font-black tracking-tight text-white">
            <%= notifications.length %>
        </span>

        <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-green-400 leading-none">
                Pending
            </p>
            <p class="text-[10px] font-black uppercase tracking-widest text-zinc-600 leading-none">
                Requests
            </p>
        </div>
    </div>

    <div class="mt-4 flex items-center gap-2 text-green-400 text-[10px] font-bold uppercase tracking-widest">
        View <i class="ri-arrow-right-up-line"></i>
    </div>

</a>
<div class="glass-card p-12 rounded-[3rem] relative overflow-hidden">
                <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-brand/10 rounded-full blur-3xl"></div>
                <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500 mb-6 italic">Idea Output</h4>
                <div class="flex items-end gap-3">
                    <span class="text-8xl font-black tracking-tighter text-white"><%= user.posts.length %></span>
                    <div class="mb-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-brand leading-none mb-1">Total</p>
                        <p class="text-[10px] font-black uppercase tracking-widest text-zinc-600 leading-none">Drafts</p>
                    </div>
                </div>
            </div>
    
</div>
      

    


            
        </div>
    </main>

    <script>
        // Cursor Lighting
        const glow = document.getElementById('cursor-glow');
        window.addEventListener('mousemove', (e) => {
            glow.style.setProperty('--x', e.clientX + 'px');
            glow.style.setProperty('--y', e.clientY + 'px');
        });
    </script>
</body>
</html>