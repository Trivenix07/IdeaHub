<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Pitch | IdeaHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: '#6366f1',
                        surface: '#050506',
                        card: '#121215'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #050506;
            color: #fafafa;
            overflow: hidden;
        }

        /* Ambient Background Glow */
        .ambient-glow {
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
        }

        /* Glassmorphism Edit Box */
        .edit-glass {
            background: rgba(18, 18, 21, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 40px 100px rgba(0,0,0,0.5);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .edit-glass:hover {
            border-color: rgba(99, 102, 241, 0.4);
            transform: translateY(-5px) scale(1.01);
        }

        /* Textarea Focus Effect */
        .refine-input {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s ease;
        }

        .refine-input:focus {
            background: rgba(255, 255, 255, 0.06);
            border-color: #6366f1;
            box-shadow: 0 0 30px rgba(99, 102, 241, 0.15);
        }

        /* Shimmer Button */
        .btn-update {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            background-size: 200% auto;
            transition: 0.5s;
        }

        .btn-update:hover {
            background-position: right center;
            box-shadow: 0 0 30px rgba(99, 102, 241, 0.4);
            transform: translateY(-2px);
        }

        /* Cursor Glow */
        #cursor-glow {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            pointer-events: none;
            background: radial-gradient(circle 350px at var(--x, 50%) var(--y, 50%), rgba(99, 102, 241, 0.1), transparent 80%);
            z-index: 1;
        }

        .fade-up {
            animation: fadeUp 0.8s ease-out forwards;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="selection:bg-brand/30">

    <div id="cursor-glow"></div>
    <div class="ambient-glow"></div>

    <nav class="flex justify-between items-center px-10 py-6 sticky top-0 bg-[#050506]/80 backdrop-blur-xl z-50 border-b border-white/5">
        <div class="flex items-center gap-10">
            <div class="flex items-center gap-3 group cursor-pointer">
                <div class="w-10 h-10 bg-brand rounded-xl flex items-center justify-center text-white shadow-[0_0_20px_rgba(99,102,241,0.3)]">
                    <i class="ri-lightbulb-flash-fill text-xl"></i>
                </div>
                <h1 class="text-xl font-bold uppercase tracking-[0.2em]">ideahub</h1>
            </div>

            <a href="/profile" class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 hover:text-brand transition-colors">
                <i class="ri-arrow-left-s-line text-lg"></i>
                Back to Studio
            </a>
        </div>
        
        <div class="flex items-center gap-6">
            <a href="/logout" class="bg-white/5 text-zinc-400 px-6 py-2 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-red-500/10 hover:text-red-400 transition-all border border-white/5">
                Logout
            </a>
        </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-24 relative z-10">
        
        <div class="mb-16 text-center fade-up">
            <span class="inline-block px-4 py-1.5 rounded-full border border-brand/20 bg-brand/5 text-brand font-bold text-[9px] tracking-[0.3em] uppercase mb-6">
                ✨ Refining the vision
            </span>
            <h2 class="text-5xl font-extrabold tracking-tighter text-white">Refine Your Pitch</h2>
        </div>

        <div class="edit-glass p-12 rounded-[3rem] fade-up" style="animation-delay: 0.1s">
            <form method="post" action="/update/<%= post._id %>" class="space-y-8">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-[0.3em] text-zinc-600 mb-6 ml-2">Manifesto Content</label>
                    <textarea name="content" placeholder="Refine your thoughts..." required
                        class="refine-input w-full p-10 rounded-[2rem] outline-none h-64 text-xl font-medium leading-relaxed text-zinc-200 placeholder:text-zinc-800 resize-none"><%= post.content %></textarea>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
                    <button type="submit" class="btn-update w-full sm:flex-[2] text-white py-5 rounded-2xl font-black text-[11px] tracking-[0.2em] uppercase shadow-2xl active:scale-95">
                        Broadcast Update
                    </button>
                    
                    <a href="/profile" class="w-full sm:flex-1 py-5 border border-white/5 rounded-2xl font-black text-[11px] tracking-[0.2em] text-zinc-500 hover:bg-white/5 hover:text-white transition uppercase text-center">
                        Discard
                    </a>
                </div>
            </form>
        </div>

        <p class="text-center mt-12 text-[10px] font-bold uppercase tracking-[0.5em] text-zinc-800 fade-up" style="animation-delay: 0.2s">
            Every giant started as a draft.
        </p>

    </main>

    <script>
        // Cursor Lighting Effect
        const glow = document.getElementById('cursor-glow');
        window.addEventListener('mousemove', (e) => {
            glow.style.setProperty('--x', e.clientX + 'px');
            glow.style.setProperty('--y', e.clientY + 'px');
        });

        // Focus Textarea automatically for high-end UX
        document.querySelector('textarea').focus();
    </script>
</body>
</html>